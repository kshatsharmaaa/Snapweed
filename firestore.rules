rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Users & profiles
    match /users/{userId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Usernames collection
    match /usernames/{username} {
      allow read, write: if true;
    }

    // Chat rooms & room messages
    match /rooms/{roomId} {
      allow read, write: if true;

      match /messages/{messageId} {
        allow read, write: if true;
      }
    }

    // Community Questions & replies
    match /questions/{questionId} {
      allow read, write: if true;
    }

    // Community Blogs (Personal Logs)
    match /blogs/{blogId} {
      allow read, write: if true;
    }

    // Community Song recommendations
    match /song_recommendations/{songId} {
      allow read, write: if true;
    }

    match /songs/{songId} {
      allow read, write: if true;
    }

    // Feedback, New Changes & Suggestions (visible after login only)
    // All logged-in users can read & create; stores strictly displayName and suggestion
    match /suggestions/{suggestionId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.keys().hasOnly(['displayName', 'suggestion'])
                    && request.resource.data.displayName is string
                    && request.resource.data.displayName.size() > 0
                    && request.resource.data.displayName.size() <= 80
                    && request.resource.data.suggestion is string
                    && request.resource.data.suggestion.size() > 0
                    && request.resource.data.suggestion.size() <= 2000;
    }
  }
}
